<?xml version="1.0"?>
<ruleset name="woo-delivery-lat">
    <description>WordPress Coding Standards for woo-delivery-lat. Errors fail CI; warnings are reported.</description>
    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/public/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="s"/>

    <config name="minimum_supported_wp_version" value="5.6"/>
    <config name="testVersion" value="7.0-"/>
    <!-- Warnings (loose comparisons, cURL, commented code...) stay visible in the report
         but do not fail the build; changing them can alter behaviour and needs testing. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="WordPress-Extra">
        <!-- camelCase variables, properties and methods mirror DB columns, option names and
             JS payload keys used since 2021; renaming them is a breaking refactor. -->
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName"/>
        <exclude name="PEAR.NamingConventions.ValidClassName"/>
        <!-- File names are referenced by admin menu slugs (admin.php?page=.../branch-office.php)
             and require statements; renaming them changes admin URLs. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- Admin pages and shortcodes print their own scripts/styles inline (Google Maps,
             Bootstrap, geoxml3); moving them to wp_enqueue_* is planned separately. -->
        <exclude name="WordPress.WP.EnqueuedResources"/>
    </rule>
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="woodeliverylat"/>
            </property>
        </properties>
    </rule>
</ruleset>
